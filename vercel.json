{
  "version": 2,
  "framework": null,
  "redirects": [
    { "source": "/", "destination": "/portal" },
    { "source": "/index.html", "destination": "/portal" }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/portal", "destination": "/api/portal" },
    { "source": "/ajax/:path*", "destination": "/api/ajax/:path*" }
  ],
  "functions": {
    "api/portal.js": { "includeFiles": "index.html" }
  }
}